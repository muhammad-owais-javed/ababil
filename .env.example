# Pinned Ollama Image Tag. Check Docker Hub for a current tag.
OLLAMA_VERSION=0.5.7

# Runtime Tuning
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# LLM Models (separate models with comma)
LLM_MODELS=qwen2.5:3b,qwen2.5vl:3b

# SandBox 
VNC_PASSWORD=<VNC-password>
SANDBOX_TOKEN=<"$(openssl rand -hex 24)">

# GPU Config
COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml